<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 콘솔 전용 색상 적용 패턴 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %magenta([%thread]) %highlight(%-5level) [%X{requestId}] [userId=%X{userId}] %cyan(%logger{36}) - %msg%n"/>

    <!-- File Appender .log 기록용 패턴 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId}] [userId=%X{userId}] %logger{36} - %msg%n"/>

    <property name="LOG_PATH" value="./logs"/>
    <property name="LOG_FILE_NAME" value="ticketing-api-log"/>
    <property name="MAX_FILE_SIZE" value="100MB"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="TOTAL_SIZE_CAP" value="3GB"/>

    <!-- appender로 출력 결정 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 롤링 방식 appender 적용 -->
    <!-- 30개(여기서는 30일치) 보관 + 파일 하나 당 최대 100MB까지 분할 저장 + 전체 합산 최대 용량은 3GB -->
    <appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/all.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="ASYNC_ALL_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ALL_FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_ALL_FILE"/>
        </root>
        <logger name="ticketing" level="DEBUG"/>
    </springProfile>

    <!-- prod는 서드파티 WARN 이상, ticketing 하위는 INFO 이상을 하나의 파일에 기록 -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_ALL_FILE"/>
        </root>
        <logger name="ticketing" level="INFO"/>
    </springProfile>

</configuration>
